# Smart Contract Auditor Agent — Environment Configuration
# Copy to .env and fill in your API keys

# LLM Provider: mimo, claude, deepseek
LLM_PROVIDER=mimo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Block Explorer API Keys (for source code verification)
ETHEREUM_EXPLORER_KEY=
ARBITRUM_EXPLORER_KEY=
OPTIMISM_EXPLORER_KEY=
BASE_EXPLORER_KEY=
BSC_EXPLORER_KEY=
POLYGON_EXPLORER_KEY=

# Custom RPC URLs (optional, defaults to public endpoints)
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Output
AUDIT_OUTPUT_DIR=./reports
AUDIT_MAX_CONCURRENT=5
AUDIT_TIMEOUT=120

# Static Analysis
ENABLE_SLITHER=true
